PORT=3000
NODE_ENV=development

MCP_SERVER_SECRET=replace_with_random_secret_used_by_retell_header

HUBSPOT_ACCESS_TOKEN=replace_with_hubspot_private_app_retell_connection_token
HUBSPOT_API_BASE=https://api.hubapi.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key_not_publishable_key

DEFAULT_TIMEZONE=Europe/Madrid

HUBSPOT_IN_PERSON_MEETING_URL=https://meetings-eu1.hubspot.com/info-madrid?uuid=your-uuid
HUBSPOT_VIRTUAL_MEETING_URL=https://meetings-eu1.hubspot.com/info-madrid/virtual-tour-booking-carabanchel?uuid=your-uuid

HUBSPOT_IN_PERSON_SLUG=info-madrid
HUBSPOT_VIRTUAL_SLUG=info-madrid/virtual-tour-booking-carabanchel

DEFAULT_TOUR_DURATION_MINUTES=30

# Retell API (required when SYNC_ENABLED=true)
RETELL_API_KEY=replace_with_retell_api_key
RETELL_API_BASE=https://api.retellai.com

# HubSpot deal filter: only sync deals where this boolean property is true
HUBSPOT_AI_CALL_ATTEMPTED_PROPERTY=ai_call_attempted
HUBSPOT_RETELL_CALL_ID_PROPERTIES=retell_call_id,retell_session_id,ai_retell_call_id
HUBSPOT_DEAL_UNIT_TYPE_PROPERTY=unit_type__carabanchel_
HUBSPOT_DEAL_CONTRACT_START_PROPERTY=desired_check_in_date
HUBSPOT_DEAL_CONTRACT_END_PROPERTY=desired_check_out_date
HUBSPOT_DEAL_PIPELINE_LABEL=Hubs B2C - Carabanchel
RETELL_SYNC_CALL_STATUSES=ended,not_connected
RETELL_SYNC_FAILED_DISCONNECTION_REASONS=dial_no_answer,dial_busy,telephony_provider_permission_denied,dial_failed

# In-process incremental sync (Option B)
SYNC_ENABLED=true
SYNC_INTERVAL_MS=3600000
SYNC_INITIAL_DELAY_MS=60000

# Episode booking backend (Housemonk proxy)
EPISODE_BACKEND_URL=https://episode-booking.onrender.com
EPISODE_BACKEND_TIMEOUT_MS=25000

# HubSpot deal updates when pricing is quoted (create matching custom properties in HubSpot)
HUBSPOT_PRICING_DEAL_UPDATE_ENABLED=true
HUBSPOT_DEAL_MONTHLY_RATE_PROPERTY=ai_quoted_monthly_rate
HUBSPOT_DEAL_TOTAL_DUE_NOW_PROPERTY=ai_total_due_now
HUBSPOT_DEAL_TOTAL_PRICE_PROPERTY=ai_total_price
HUBSPOT_DEAL_QUOTED_UNIT_PROPERTY=ai_quoted_unit_type
HUBSPOT_DEAL_QUOTED_CHECKIN_PROPERTY=ai_quoted_check_in
HUBSPOT_DEAL_QUOTED_CHECKOUT_PROPERTY=ai_quoted_check_out

# HubSpot portal ID (optional — fetched from API if omitted)
HUBSPOT_PORTAL_ID=

# Tour booking notification email (sent after successful book_tour)
TOUR_BOOKING_EMAIL_ENABLED=true
TOUR_BOOKING_NOTIFY_EMAIL=claudio@episode.life
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=claudio@episode.life
SMTP_PASSWORD=replace_with_gmail_app_password
SMTP_FROM=claudio@episode.life

# Notion live sync (retell_sessions → Sprints page database)
# Option A: OAuth public connection
NOTION_CLIENT_ID=replace_with_notion_oauth_client_id
NOTION_CLIENT_SECRET=replace_with_notion_oauth_client_secret
NOTION_REDIRECT_URI=https://ai-calling-j1hu.onrender.com/auth/notion/callback
# Set automatically after visiting /auth/notion — copy from success page into Render
NOTION_API_KEY=
NOTION_REFRESH_TOKEN=
# Option B: internal integration secret (skip OAuth if you use this instead)
# NOTION_API_KEY=replace_with_notion_internal_integration_token
NOTION_SPRINTS_PAGE_ID=3ab762e2-8bfc-802b-82db-cd3dfc1c05e3
NOTION_SEARCH_PAGE_IDS=3ab762e2-8bfc-802b-82db-cd3dfc1c05e3,28b762e2-8bfc-8039-a24b-cee7a5cdb094
NOTION_DATABASE_TITLE=Supabase retell_sessions
NOTION_RETELL_DATABASE_ID=
NOTION_AUTO_CREATE_DATABASE=true
NOTION_SYNC_ENABLED=true
NOTION_SYNC_INTERVAL_MS=300000
NOTION_SYNC_INITIAL_DELAY_MS=30000
NOTION_API_VERSION=2022-06-28
NOTION_MCP_TOOLS_SECTION_TITLE=MCP/General Tools Implemented or Needed
NOTION_MCP_TOOLS_SECTION_BLOCK_ID=3b2762e2-8bfc-800d-8bc1-00a975c6bd54
